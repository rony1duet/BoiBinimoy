<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E5E7EB"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvRequestBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_pill_button"
                android:backgroundTint="@color/primary_green_mint"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="@color/primary_green"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="OPEN REQUEST" />

            <TextView
                android:id="@+id/tvRequestTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tvRequestBadge"
                android:layout_marginEnd="8dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Wanted: Deep Work" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tvRequestAuthorCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="by Cal Newport • Category: Business" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRequestUserLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                tools:text="User • Dhaka" />

            <TextView
                android:id="@+id/tvRequestPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_green"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Budget: ~৳ 250" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvRequestNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search_bar"
            android:padding="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="italic"
            tools:text="&quot;Looking for a copy in good condition. Willing to buy or trade with any book from my profile.&quot;" />

        <LinearLayout
            android:id="@+id/layoutRequestActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteRequest"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:text="Admin Delete"
                android:textColor="@color/heart_red"
                android:textSize="11sp"
                android:visibility="gone"
                app:strokeColor="@color/heart_red"
                app:strokeWidth="1dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOfferBook"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="I Have This Book (Chat)"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/primary_green" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
